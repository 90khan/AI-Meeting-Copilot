# Copy this file to .env for local development. Do not commit .env files.
AI_MEETING_COPILOT_ENVIRONMENT=development
AI_MEETING_COPILOT_DEBUG=false
AI_MEETING_COPILOT_LOG_LEVEL=INFO
# AI_MEETING_COPILOT_RECORDINGS_ROOT_DIRECTORY=./data/recordings
AI_MEETING_COPILOT_RECORDING_SEGMENT_MAX_PLAINTEXT_BYTES=67108864
AI_MEETING_COPILOT_SPEECH_TO_TEXT_PROVIDER=unconfigured
AI_MEETING_COPILOT_TRANSLATION_PROVIDER=unconfigured
AI_MEETING_COPILOT_GERMAN_SIMPLIFICATION_PROVIDER=unconfigured
AI_MEETING_COPILOT_REPLY_COACHING_PROVIDER=unconfigured
AI_MEETING_COPILOT_MEETING_SUMMARIZATION_PROVIDER=unconfigured
AI_MEETING_COPILOT_FASTER_WHISPER_MODEL=small
AI_MEETING_COPILOT_FASTER_WHISPER_DEVICE=cpu
AI_MEETING_COPILOT_FASTER_WHISPER_COMPUTE_TYPE=int8
AI_MEETING_COPILOT_FASTER_WHISPER_BEAM_SIZE=5
AI_MEETING_COPILOT_FASTER_WHISPER_VAD_ENABLED=false
# AI_MEETING_COPILOT_FASTER_WHISPER_CPU_THREADS=4
# AI_MEETING_COPILOT_FASTER_WHISPER_DOWNLOAD_DIRECTORY=./data/models
AI_MEETING_COPILOT_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MEETING_COPILOT_OLLAMA_TRANSLATION_MODEL=qwen2.5:3b
AI_MEETING_COPILOT_OLLAMA_GERMAN_SIMPLIFICATION_MODEL=qwen2.5:3b
AI_MEETING_COPILOT_OLLAMA_REPLY_COACHING_MODEL=qwen2.5:3b
AI_MEETING_COPILOT_OLLAMA_MEETING_SUMMARIZATION_MODEL=qwen2.5:3b
AI_MEETING_COPILOT_OLLAMA_REQUEST_TIMEOUT_SECONDS=120.0
AI_MEETING_COPILOT_OLLAMA_TEMPERATURE=0.1
AI_MEETING_COPILOT_OLLAMA_CONTEXT_LENGTH=8192
AI_MEETING_COPILOT_OLLAMA_KEEP_ALIVE=5m
# Set this only for local desktop-sidecar startup; never commit a real token.
# AI_MEETING_COPILOT_SIDECAR_AUTH_TOKEN=replace-with-a-random-local-token
AI_MEETING_COPILOT_SIDECAR_HOST=127.0.0.1
AI_MEETING_COPILOT_SIDECAR_PORT=0
AI_MEETING_COPILOT_SIDECAR_STARTUP_TIMEOUT_SECONDS=15.0
