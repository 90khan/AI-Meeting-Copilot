# Copy this file to .env for local development. Do not commit .env files.
AI_MEETING_COPILOT_ENVIRONMENT=development
AI_MEETING_COPILOT_DEBUG=false
AI_MEETING_COPILOT_LOG_LEVEL=INFO
AI_MEETING_COPILOT_SPEECH_TO_TEXT_PROVIDER=unconfigured
AI_MEETING_COPILOT_TRANSLATION_PROVIDER=unconfigured
AI_MEETING_COPILOT_GERMAN_SIMPLIFICATION_PROVIDER=unconfigured
AI_MEETING_COPILOT_REPLY_COACHING_PROVIDER=unconfigured
AI_MEETING_COPILOT_MEETING_SUMMARIZATION_PROVIDER=unconfigured
AI_MEETING_COPILOT_FASTER_WHISPER_MODEL=small
AI_MEETING_COPILOT_FASTER_WHISPER_DEVICE=cpu
AI_MEETING_COPILOT_FASTER_WHISPER_COMPUTE_TYPE=int8
AI_MEETING_COPILOT_FASTER_WHISPER_BEAM_SIZE=5
AI_MEETING_COPILOT_FASTER_WHISPER_VAD_ENABLED=false
# AI_MEETING_COPILOT_FASTER_WHISPER_CPU_THREADS=4
# AI_MEETING_COPILOT_FASTER_WHISPER_DOWNLOAD_DIRECTORY=./data/models
